# Postgres
DATABASE_URL=postgres://muster:muster@localhost:5432/muster

# Backend (webhooks + admin API + sync)
BACKEND_PORT=8080
ADMIN_TOKEN=change-me-long-random-string

# GitHub App (ONE app, installed once on the org/repos)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=change-me
# Optional: enable the store -> GitHub mirror (labels, and Projects v2 Status
# for projects that have github_project_number set)
GITHUB_SYNC_ENABLED=false
GITHUB_SYNC_INTERVAL_SEC=180
# Mirror status as muster:*/lead:* labels on the issue. Turn off if you only
# want the Projects v2 board written.
GITHUB_SYNC_LABELS=true
# Most tasks mirrored per cycle.
GITHUB_SYNC_BATCH=200
# Nightly reconcile: diff GitHub issues against the store to catch webhook
# deliveries that never arrived. Cron is UTC.
GITHUB_RECONCILE_ENABLED=false
GITHUB_RECONCILE_CRON=17 3 * * *

# MCP server (leads connect here with per-lead bearer tokens)
MCP_PORT=8090
# Default lease length for claimed tasks
CLAIM_LEASE_SECONDS=1800
