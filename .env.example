# Postgres
DATABASE_URL=postgres://muster:muster@localhost:5432/muster

# Backend (webhooks + admin API + sync)
BACKEND_PORT=8080
ADMIN_TOKEN=change-me-long-random-string

# GitHub App (ONE app, installed once on the org/repos)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=change-me
# Optional: enable store -> GitHub Projects mirror
GITHUB_SYNC_ENABLED=false
GITHUB_SYNC_INTERVAL_SEC=180

# MCP server (leads connect here with per-lead bearer tokens)
MCP_PORT=8090
# Default lease length for claimed tasks
CLAIM_LEASE_SECONDS=1800
