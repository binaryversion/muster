# Muster configuration. Everything the stack reads lives here; docker compose
# picks this file up automatically, and a platform that injects environment
# variables (Coolify, Dokploy, systemd) overrides it.
#
#   cp .env.example .env
#
# Generate the two secrets with:  openssl rand -base64 24

# ── Required ──────────────────────────────────────────────────────────────────
# Postgres password. Compose refuses to start without it.
POSTGRES_PASSWORD=change-me
# Backoffice password, for https://<backend>/ui/ and as the admin API bearer
# token. Unset, the admin API answers 503 rather than opening up.
ADMIN_PASSWORD=change-me-too
# Keys the lead-token digests in the database. Without it a stolen dump could
# be used to test token guesses offline; with it the dump is inert. At least 32
# bytes, base64 or hex.
#   openssl rand -base64 32
# Rotating this invalidates every outstanding lead token at once, which is a
# kill switch as well as a chore: you have to reissue them.
ENC_KEY=change-me-with-openssl-rand-base64-32

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=muster
POSTGRES_DB=muster
POSTGRES_VERSION=16
# Published for host tooling (psql, scripts/smoke.sh). Loopback only; set
# DB_BIND=0.0.0.0 only if something off this machine genuinely needs the database.
DB_BIND=127.0.0.1
DB_PORT=5432
# Used by scripts/migrate.sh and scripts/smoke.sh when run from the host.
DATABASE_URL=postgres://muster:change-me@localhost:5432/muster

# ── Backend (webhooks, admin API + UI, event stream, sync, reconcile) ─────────
BACKEND_PORT=8080
BACKEND_BIND=0.0.0.0
# How long a backoffice sign-in lasts, and how many wrong passwords from one
# client before it is locked out for five minutes.
ADMIN_SESSION_HOURS=12
ADMIN_LOGIN_ATTEMPTS=8
# Read X-Forwarded-* headers. Leave true behind any reverse proxy; it is what
# lets the session cookie be marked Secure and the login throttle see real IPs.
TRUST_PROXY=true

# ── MCP server (leads connect here with per-lead bearer tokens) ───────────────
MCP_PORT=8090
MCP_BIND=0.0.0.0
# Default lease length for a claimed task.
CLAIM_LEASE_SECONDS=1800

# ── GitHub App (optional) ─────────────────────────────────────────────────────
# ONE app, installed once on the org/repos. Without these the store, the MCP
# tools and the backoffice all still work; only the GitHub bridge is off.
GITHUB_APP_ID=
# The private key itself, so no file has to exist in the container. Paste the
# PEM; \n escapes and base64 are both accepted. A single line works:
#   GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=
# Only for a local checkout with the .pem on disk; ignored if the key above is set.
# GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=

# Store -> GitHub mirror: muster:*/lead:* labels, and the Projects v2 Status
# column for projects with a board wired up.
GITHUB_SYNC_ENABLED=false
GITHUB_SYNC_INTERVAL_SEC=180
GITHUB_SYNC_LABELS=true
GITHUB_SYNC_BATCH=200

# Nightly diff of GitHub against the store, to catch webhook deliveries that
# never arrived. Cron is UTC.
GITHUB_RECONCILE_ENABLED=false
GITHUB_RECONCILE_CRON=17 3 * * *

# ── Compose ───────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=muster
RESTART_POLICY=unless-stopped
